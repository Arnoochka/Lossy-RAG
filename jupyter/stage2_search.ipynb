    "def evaluate_search(\n",
    "    chunks: pd.DataFrame,\n",
    "    questions: pd.DataFrame,\n",
    "    answer_chunks: pd.DataFrame,\n",
    "    metric_fns: tuple[Callable[[np.ndarray, set[int]], float], ...],\n",
    "    searcher: search.BaseSearch,\n",
    "    ks: tuple[int, ...] = (1, 5, 10),\n",
    ") -> dict[str, pd.DataFrame]:\n",
    "    \"\"\"Обучает поиск на train-текстах и считает метрики train/valid по одной выдаче.\n",
    "\n",
    "    Поиск идёт по всей базе. Исходные вопросы и перефразы оцениваются отдельно.\n",
    "    \"\"\"\n",
    "    train_pids = questions.loc[questions[\"role\"] == \"train\", \"pid\"]\n",
    "    chunk_train_mask = chunks[\"pid\"].isin(train_pids)\n",
    "    searcher.fit(chunks.loc[chunk_train_mask, \"text\"].tolist())\n",
    "    searcher.add(chunks[\"text\"].tolist(), chunks[\"chunk_id\"].to_numpy())\n",
    "    top_ids, _ = searcher.search(questions[\"question\"].tolist(), k=max(ks))\n",
    "    metrics = {}\n",
    "    for metric_fn in metric_fns:\n",
    "        results = []\n",
    "        for role in (\"train\", \"valid\"):\n",
    "            for question_type, is_paraphrase in ((\"real\", False), (\"paraphrase\", True)):\n",
    "                mask = (\n",
    "                    (questions[\"role\"] == role)\n",
    "                    & (questions[\"is_paraphrase\"] == is_paraphrase)\n",
    "                ).to_numpy()\n",
    "                group_metrics = calculate_metrics(\n",
    "                    top_ids[mask], questions.loc[mask], answer_chunks, metric_fn, ks,\n",
    "                )\n",
    "                group_metrics.columns = [\n",
    "                    f\"{role}_{name}_{question_type}\" for name in group_metrics.columns\n",
    "                ]\n",
    "                results.append(group_metrics)\n",
    "        metrics[metric_fn.__name__] = pd.concat(results, axis=1)\n",
    "    return metrics\n"
   ]
  },
  {
