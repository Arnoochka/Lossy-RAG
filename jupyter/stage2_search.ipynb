    "def hit(retrieved: np.ndarray, relevant: set[int]) -> float:\n",
    "    \"\"\"Есть ли среди найденных фрагментов хотя бы один эталонный.\"\"\"\n",
    "    return float(len(set(retrieved) & relevant) > 0)\n",
    "\n",
    "\n",
    "def precision(retrieved: np.ndarray, relevant: set[int]) -> float:\n",
    "    \"\"\"Доля эталонных фрагментов среди найденных.\"\"\"\n",
    "    retrieved_set = set(retrieved)\n",
    "    return len(retrieved_set & relevant) / len(retrieved_set)\n",
    "\n",
    "\n",
    "def recall(retrieved: np.ndarray, relevant: set[int]) -> float:\n",
    "    \"\"\"Доля найденных фрагментов среди всех эталонных.\"\"\"\n",
    "    return len(set(retrieved) & relevant) / len(relevant)\n",
    "\n",
    "\n",
    "def mrr(retrieved: np.ndarray, relevant: set[int]) -> float:\n",
    "    \"\"\"Обратный ранг первого эталонного фрагмента; 0, если его нет.\"\"\"\n",
    "    for rank, chunk_id in enumerate(retrieved, start=1):\n",
    "        if chunk_id in relevant:\n",
    "            return 1.0 / rank\n",
    "    return 0.0\n",
    "\n",
    "\n",
    "def calculate_metrics(\n",
    "    top_ids: np.ndarray,\n",
    "    questions: pd.DataFrame, \n",
    "    answer_chunks: pd.DataFrame,\n",
    "    metric_fn: Callable[[np.ndarray, set[int]], float],\n",
    "    ks: tuple[int,...] = (1, 5, 10),\n",
    ") -> pd.DataFrame:\n",
    "    \"\"\"Усредняет выбранную метрику по строгому и мягкому эталонам.\"\"\"\n",
    "    metrics = {}\n",
    "    for name, gold in (\n",
    "        (\"strict\", answer_chunks[answer_chunks[\"is_annotated\"]]),\n",
    "        (\"soft\", answer_chunks),\n",
    "    ):\n",
    "        gold_chunks = gold.groupby(\"orig_qid\")[\"chunk_id\"].agg(set).to_dict()\n",
    "        metrics[name] = []\n",
    "        for k in ks:\n",
    "            values = [\n",
    "                metric_fn(row[:k], gold_chunks[orig_qid])\n",
    "                for orig_qid, row in zip(questions[\"orig_qid\"], top_ids)\n",
    "            ]\n",
    "            metrics[name].append(np.mean(values))\n",
    "\n",
    "    return pd.DataFrame(metrics, index=pd.Index(ks, name=\"k\"))"
   ]
  },
