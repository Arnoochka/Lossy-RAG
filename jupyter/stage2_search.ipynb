    "model_name = \"BAAI/bge-small-en-v1.5\"\n",
    "save_dir = data_dir / f\"embeddings_{model_name.rsplit('/', 1)[-1]}\"\n",
    "\n",
    "chunk_ids = np.load(save_dir / \"chunk_ids.npy\")\n",
    "chunk_embeddings = np.load(save_dir / \"chunk_embeddings.npy\")\n",
    "query_ids = np.load(save_dir / \"query_ids.npy\")\n",
    "query_embeddings = np.load(save_dir / \"query_embeddings.npy\")\n",
    "\n",
    "chunks = chunks.set_index(\"chunk_id\", drop=False).loc[chunk_ids].reset_index(drop=True)\n",
    "questions = questions.set_index(\"qid\", drop=False).loc[query_ids].reset_index(drop=True)\n"
   ]
  },
