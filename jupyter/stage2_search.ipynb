    "from tqdm import tqdm\n",
    "\n",
    "def conduct_experiments(exps: dict[str, search.BaseSearch],\n",
    "                        save_dir: Path,\n",
    "                        metric_fns: tuple[Callable[[np.ndarray, set[int]], float], ...],\n",
    "                        ks: tuple[int,...]) -> None:\n",
    "\n",
    "    for name, searcher in tqdm(exps.items()):\n",
    "        results = evaluate_search(\n",
    "            chunks=chunks,\n",
    "            questions=questions,\n",
    "            answer_chunks=answer_chunks,\n",
    "            metric_fns=metric_fns,\n",
    "            searcher=searcher,\n",
    "            ks=ks)\n",
    "        for metric_name, metrics in results.items():\n",
    "            metric_dir = save_dir / metric_name\n",
    "            metric_dir.mkdir(parents=True, exist_ok=True)\n",
    "            save_path = metric_dir / f\"exp_{name}.csv\"\n",
    "            metrics.to_csv(save_path, index=False)\n",
    "            print(f\"{name}: {save_path}\")\n",
    "\n",
    "KS = (1, 5, 10, 15, 20, 25)\n"
   ]
  },
